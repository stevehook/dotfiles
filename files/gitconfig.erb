[user]
  name = Steve Hook
  email = steve.hook@gmail.com

[alias]
  c = commit
  ca = commit -a
  br = branch
  co = checkout
  lp = log -p
  who = shortlog -n -s --no-merges
  undo = reset --hard
  lc = log ORIG_HEAD.. --stat --no-merges
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(cyan)<%an>%Creset' --abbrev-commit --date=relative
  lf = log --pretty=fuller
  cleanup = !git gc && git remote prune origin
  fork = remote add -f
  s = status
  b = branch
  ba = branch -avv
  f = fetch
  fo = fetch origin
  m = merge
  r = rebase
  p = pull

[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[github]

[commit]
	verbose = true
	gpgsign = true

[core]
	editor = nvim
  pager = diff-highlight
  excludesfile = /Users/steve/.gitignore_global
  templatedir = ~/.git_template
	UseHttpPath = true

[merge]
	ff = false
	conflictStyle = zdiff3

diff]
	algorigthm = histogram
	colorMoved = default

[difftool]
	prompt = false
	trustExitCode = true

[fetch]
	prune = true

[pull]
	rebase = true

[core]

[log]
	date = iso

[init]
  templatedir = ~/.git_template
	defaultBranch = main

[rerere]
	enabled = true

[mailmap]
	file = /home/peter/.mailmap

[blame]
	coloring = highlightRecent

[color "blame"]
	highlightRecent = white,1 month ago,yellow,1 week ago,red
